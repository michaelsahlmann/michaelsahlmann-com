---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = "Michael Sahlmann | Experto en Negocios, Productividad e Inteligencia Artificial",
  description = "Con más de 9 años transformando empresas y profesionales, Michael Sahlmann combina la optimización de procesos, productividad de élite e Inteligencia Artificial para alcanzar MÁS con MENOS esfuerzo.",
  image = "/images/michael-sahlmann.webp",
  canonical = "https://michaelsahlmann.com/"
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://michaelsahlmann.com/#person",
      "name": "Michael Sahlmann",
      "url": "https://michaelsahlmann.com/",
      "image": "https://michaelsahlmann.com/images/michael-sahlmann.webp",
      "jobTitle": "Consultor Empresarial, Conferencista Internacional y Especialista en Inteligencia Artificial",
      "worksFor": {
        "@type": "Organization",
        "name": "Varkentis Holding"
      },
      "address": {
        "@type": "PostalAddress",
        "addressRegion": "Alto Paraná",
        "addressLocality": "Alto Paraná",
        "addressCountry": "Paraguay"
      },
      "description": "Líder en Paraguay en optimización de negocios, metodologías de productividad e integración estratégica de Inteligencia Artificial en organizaciones.",
      "knowsAbout": [
        "Inteligencia Artificial para Negocios",
        "Automatización de Procesos con N8N",
        "Framework Linchpin de Negocios Escalables",
        "Productividad y Foco para Líderes",
        "Entrenamiento Empresarial y Conferencias"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://michaelsahlmann.com/#website",
      "url": "https://michaelsahlmann.com/",
      "name": "Michael Sahlmann - Sitio Oficial",
      "description": description,
      "publisher": {
        "@id": "https://michaelsahlmann.com/#person"
      },
      "inLanguage": "es"
    }
  ]
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:site_name" content="Michael Sahlmann" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/images/varkentis-logo.svg" />
    <link rel="apple-touch-icon" href="/images/michael-sahlmann.webp" />
    <meta name="theme-color" content="#050505" />

    <!-- Preload Critical Typography (Zero CLS & Instant Paint) -->
    <link
      rel="preload"
      href="/fonts/YoungSerif-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Labrada-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#050505] text-white selection:bg-[#F26101] selection:text-white relative min-h-screen antialiased">
    <!-- Texture noise overlay -->
    <div class="bg-noise"></div>

    <slot />

    <!-- Smooth Page Scripts -->
    <script is:inline>
      // Header scroll glass effect
      window.addEventListener('scroll', () => {
        const header = document.getElementById('navbar-capsule');
        if (header) {
          if (window.scrollY > 40) {
            header.classList.add('bg-[#050505]/95', 'shadow-2xl', 'border-white/15');
            header.classList.remove('bg-[#050505]/80', 'border-white/10');
          } else {
            header.classList.remove('bg-[#050505]/95', 'shadow-2xl', 'border-white/15');
            header.classList.add('bg-[#050505]/80', 'border-white/10');
          }
        }
      });
    </script>
  </body>
</html>
