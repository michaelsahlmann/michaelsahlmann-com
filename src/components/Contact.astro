---
---

<section id="contacto" class="py-28 bg-[#050505] relative overflow-hidden border-t border-white/10">
  <!-- Volumetric ambient light -->
  <div class="absolute bottom-0 right-0 w-[600px] h-[600px] volumetric-orange opacity-20 pointer-events-none -z-10 translate-x-1/4"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-5">
        <span class="inline-block font-code text-xs text-[#F26101] tracking-wider uppercase font-bold mb-3">
          Contacto Directo & Auditoría
        </span>
        <h2 class="font-display text-[clamp(2.2rem,5vw,3.6rem)] font-light leading-[1.08] text-white mb-6">
          Comencemos a <br />
          <span class="italic text-[#F26101]">construir evidencia.</span>
        </h2>
        
        <p class="text-base text-slate-300 leading-relaxed font-normal mb-8">
          Si estás listo para erradicar cuellos de botella en tu empresa, capacitar a tu equipo con herramientas de Inteligencia Artificial o coordinar una conferencia, completa el formulario.
        </p>

        <div class="space-y-4 text-sm text-slate-300">
          <div class="flex items-start gap-3">
            <span class="text-[#F26101] font-bold mt-1">&check;</span>
            <span>Diagnóstico de procesos e identificación de tareas automatizables.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-[#F26101] font-bold mt-1">&check;</span>
            <span>Implementación práctica con impacto medible en eficiencia y rentabilidad.</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-[#F26101] font-bold mt-1">&check;</span>
            <span>Respuesta estratégica a tu consulta en menos de 24 horas hábiles.</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form connected to n8n Webhook -->
      <div class="lg:col-span-7 bg-[#0A0D14] border border-white/15 rounded-3xl p-8 sm:p-10 shadow-2xl relative">
        <h3 class="font-display text-2xl text-white font-normal mb-2">Formulario de Consulta Estratégica</h3>
        <p class="text-sm text-slate-400 font-normal mb-8">Completa los campos y el equipo se pondrá en contacto a la brevedad.</p>

        <form id="contact-form" class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs text-slate-300 uppercase tracking-wider mb-2 font-medium">Tu Nombre Completo *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. Juan Pérez"
                class="w-full bg-[#050505] border border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#F26101] transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-xs text-slate-300 uppercase tracking-wider mb-2 font-medium">Correo Electrónico *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="juan@tuempresa.com"
                class="w-full bg-[#050505] border border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#F26101] transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="company" class="block text-xs text-slate-300 uppercase tracking-wider mb-2 font-medium">Empresa & Cargo</label>
            <input
              type="text"
              id="company"
              name="company"
              placeholder="Ej. Empresa S.A. / Director de Operaciones"
              class="w-full bg-[#050505] border border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#F26101] transition-colors"
            />
          </div>

          <div>
            <label for="interest" class="block text-xs text-slate-300 uppercase tracking-wider mb-2 font-medium">¿En qué formato requieres la solución? *</label>
            <select
              id="interest"
              name="interest"
              required
              class="w-full bg-[#050505] border border-white/20 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#F26101] transition-colors cursor-pointer"
            >
              <option value="Consultoría en IA y Procesos">Consultoría de Integración de IA & Automatización</option>
              <option value="Conferencia Magistral">Conferencia Magistral / Keynote para Evento</option>
              <option value="Entrenamiento In-Company">Entrenamiento Corporativo para Equipo</option>
              <option value="Mentoría 1 a 1">Mentoría Estratégica 1 a 1 para Directores</option>
              <option value="Otro">Otra consulta específica</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs text-slate-300 uppercase tracking-wider mb-2 font-medium">Detalle del Desafío o Consulta *</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntanos sobre las tareas manuales, cuellos de botella actuales de tu empresa o las metas que deseas alcanzar..."
              class="w-full bg-[#050505] border border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#F26101] transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 px-8 rounded-full text-xs font-bold tracking-widest uppercase bg-white text-black hover:bg-[#F26101] hover:text-white transition-all duration-300 shadow-xl flex items-center justify-center gap-2 group cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btn-text">Enviar Solicitud Estratégica</span>
            <span id="btn-arrow" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </button>
        </form>

        <!-- Feedback Messages -->
        <div id="form-success" class="hidden mt-6 p-6 rounded-2xl bg-emerald-950/40 border border-emerald-500/40 text-emerald-200 text-sm text-center">
          <div class="text-xl mb-1">&check;</div>
          <p class="font-semibold text-white mb-1">¡Solicitud recibida con éxito!</p>
          <p class="text-xs text-emerald-300/90">Tus datos han sido enviados directamente a nuestro sistema. Me pondré en contacto contigo pronto.</p>
        </div>

        <div id="form-error" class="hidden mt-6 p-6 rounded-2xl bg-red-950/40 border border-red-500/40 text-red-200 text-sm text-center">
          <p class="font-semibold text-white mb-1">No se pudo enviar la solicitud</p>
          <p class="text-xs text-red-300/90" id="error-message">Por favor intenta de nuevo en unos momentos.</p>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successBox = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const errorMessage = document.getElementById('error-message');

  const WEBHOOK_URL = 'https://michaelsahlmann.app.n8n.cloud/webhook/b25e9e91-2f2c-4419-b39e-4a190c3ad404';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (errorBox) errorBox.classList.add('hidden');

      const name = document.getElementById('name')?.value?.trim() || '';
      const email = document.getElementById('email')?.value?.trim() || '';
      const company = document.getElementById('company')?.value?.trim() || '';
      const interest = document.getElementById('interest')?.value || '';
      const message = document.getElementById('message')?.value?.trim() || '';

      const payload = {
        name,
        email,
        company,
        interest,
        message,
        submittedAt: new Date().toISOString(),
        source: 'michaelsahlmann.com'
      };

      // Loading state
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
      }
      if (btnText) btnText.textContent = 'Enviando solicitud...';
      if (btnArrow) btnArrow.classList.add('hidden');

      try {
        const response = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload)
        });

        if (response.ok || response.status === 200 || response.status === 201) {
          form.classList.add('hidden');
          if (successBox) successBox.classList.remove('hidden');
        } else {
          throw new Error(`Respuesta del servidor: ${response.status}`);
        }
      } catch (err) {
        console.error('Error al enviar al webhook de n8n:', err);
        // Fallback: If n8n webhook returns opaque or CORS on some setups, consider whether it sent
        // But still provide clear feedback:
        if (errorBox) {
          errorBox.classList.remove('hidden');
          if (errorMessage) {
            errorMessage.textContent = 'Hubo un detalle de conexión. Por favor reintenta o verifica tu conexión a internet.';
          }
        }
        if (submitBtn) submitBtn.removeAttribute('disabled');
        if (btnText) btnText.textContent = 'Reintentar Envío';
        if (btnArrow) btnArrow.classList.remove('hidden');
      }
    });
  }
</script>
