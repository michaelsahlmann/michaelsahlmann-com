---
---

<section id="contacto" class="py-28 bg-[#050505] relative overflow-hidden border-t border-white/10">
  <!-- Volumetric ambient light -->
  <div class="absolute bottom-0 right-0 w-[600px] h-[600px] volumetric-orange opacity-20 pointer-events-none -z-10 translate-x-1/4"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Information & Direct Channels -->
      <div class="lg:col-span-5">
        <span class="font-code text-xs text-[#F26101] tracking-[0.2em] uppercase font-bold block mb-3">
          Contacto Directo & Auditoría
        </span>
        <h2 class="font-display text-[clamp(2.2rem,5vw,3.6rem)] font-light leading-[1.08] text-white mb-6">
          Comencemos a <br />
          <span class="italic text-[#F26101]">construir evidencia.</span>
        </h2>
        
        <p class="text-sm sm:text-base text-[#D6D6DC] leading-relaxed font-light mb-8">
          El confort y las dudas no generan resultados. Si estás listo para auditar tus operaciones, capacitar a tu equipo o invitar a Michael a tu próximo evento, contáctanos hoy.
        </p>

        <!-- Direct WhatsApp Callout Box -->
        <div class="bg-[#0F1520] border border-white/15 rounded-3xl p-6 mb-8 hover:border-[#F26101]/40 transition-colors">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <span class="font-code text-xs text-white font-semibold block">Canal Directo de Respuesta Rápida</span>
              <span class="text-[11px] text-white/50">Atención personalizada para ejecutivos</span>
            </div>
          </div>
          <a
            href="https://wa.me/595981000000?text=Hola%20Michael,%20deseo%20coordinar%20una%20sesi%C3%B3n%20estrat%C3%A9gica%20contigo."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-full text-xs font-bold tracking-widest uppercase bg-emerald-500 hover:bg-emerald-400 text-black transition-all font-code"
          >
            <span>Conversar vía WhatsApp</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- Contact points list -->
        <div class="space-y-4 font-code text-xs text-white/70">
          <div class="flex items-center gap-3">
            <span class="text-[#F26101]">&bull;</span>
            <span><strong>Ubicación:</strong> Asunción, Paraguay</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#F26101]">&bull;</span>
            <span><strong>Modalidad:</strong> Presencial &bull; Virtual para toda la región</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#F26101]">&bull;</span>
            <span><strong>Email Oficial:</strong> contacto@michaelsahlmann.com</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7 bg-[#0A0D14] border border-white/10 rounded-3xl p-8 sm:p-10 shadow-2xl relative">
        <h3 class="font-display text-2xl text-white font-light mb-2">Formulario de Consulta Estratégica</h3>
        <p class="text-xs text-[#D6D6DC]/70 font-light mb-8">Completa los campos a continuación y recibirás respuesta en menos de 24 horas hábiles.</p>

        <form id="contact-form" class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block font-code text-[11px] text-white/70 uppercase tracking-wider mb-2 font-medium">Tu Nombre Completo *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. Juan Pérez"
                class="w-full bg-[#050505] border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-[#F26101] transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block font-code text-[11px] text-white/70 uppercase tracking-wider mb-2 font-medium">Correo Electrónico *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="juan@tuempresa.com"
                class="w-full bg-[#050505] border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-[#F26101] transition-colors"
              />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="company" class="block font-code text-[11px] text-white/70 uppercase tracking-wider mb-2 font-medium">Empresa & Cargo</label>
              <input
                type="text"
                id="company"
                name="company"
                placeholder="Empresa S.A. / Director"
                class="w-full bg-[#050505] border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-[#F26101] transition-colors"
              />
            </div>
            <div>
              <label for="phone" class="block font-code text-[11px] text-white/70 uppercase tracking-wider mb-2 font-medium">WhatsApp / Teléfono *</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="+595 981 123 456"
                class="w-full bg-[#050505] border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-[#F26101] transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="interest" class="block font-code text-[11px] text-white/70 uppercase tracking-wider mb-2 font-medium">¿En qué formato requieres la solución? *</label>
            <select
              id="interest"
              name="interest"
              required
              class="w-full bg-[#050505] border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#F26101] transition-colors cursor-pointer"
            >
              <option value="Consultoría en IA y Procesos">Consultoría de Integración de IA & Automatización</option>
              <option value="Conferencia Magistral">Conferencia Magistral / Keynote para Evento</option>
              <option value="Entrenamiento In-Company">Entrenamiento Corporativo para Equipo</option>
              <option value="Mentoría 1 a 1">Mentoría Estratégica 1 a 1 para Directores</option>
              <option value="Otro">Otra consulta específica</option>
            </select>
          </div>

          <div>
            <label for="message" class="block font-code text-[11px] text-white/70 uppercase tracking-wider mb-2 font-medium">Detalle del Desafío o Evento *</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntanos sobre los cuellos de botella actuales de tu empresa, fechas de tu evento o metas que buscas alcanzar..."
              class="w-full bg-[#050505] border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-[#F26101] transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 px-8 rounded-full text-xs font-black tracking-[0.2em] uppercase bg-white text-black hover:bg-[#F26101] hover:text-white transition-all duration-300 shadow-xl flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span>Enviar Solicitud Estratégica</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </button>
        </form>

        <div id="form-success" class="hidden mt-6 p-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-code text-center">
          ✓ Solicitud enviada con éxito. Michael o su equipo se pondrán en contacto a la brevedad.
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = document.getElementById('name')?.value || '';
      const email = document.getElementById('email')?.value || '';
      const company = document.getElementById('company')?.value || '';
      const phone = document.getElementById('phone')?.value || '';
      const interest = document.getElementById('interest')?.value || '';
      const message = document.getElementById('message')?.value || '';

      // Prepare WhatsApp fallback redirect or notification
      const fullText = `*Nueva Solicitud desde michaelsahlmann.com*%0A%0A*Nombre:* ${encodeURIComponent(name)}%0A*Email:* ${encodeURIComponent(email)}%0A*Empresa:* ${encodeURIComponent(company)}%0A*Tel:* ${encodeURIComponent(phone)}%0A*Interés:* ${encodeURIComponent(interest)}%0A*Mensaje:* ${encodeURIComponent(message)}`;

      if (submitBtn) {
        submitBtn.innerHTML = `<span>Procesando...</span>`;
        submitBtn.setAttribute('disabled', 'true');
      }

      setTimeout(() => {
        form.classList.add('hidden');
        if (successBox) {
          successBox.classList.remove('hidden');
        }
        // Open WhatsApp with all submitted details
        window.open(`https://wa.me/595981000000?text=${fullText}`, '_blank');
      }, 700);
    });
  }
</script>
