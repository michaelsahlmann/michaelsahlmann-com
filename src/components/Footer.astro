<footer class="py-16 bg-[#000000] border-t border-white/10 relative z-10 text-white">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="grid md:grid-cols-12 gap-10 items-center justify-between pb-12 border-b border-white/10">
      
      <!-- Left: Logo & Identity -->
      <div class="md:col-span-6 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-white/5 border border-white/15 flex items-center justify-center p-1.5">
            <svg class="w-full h-full fill-white" viewBox="0 0 1024 1024">
              <path d="M8195 6824 c-96 -183 -276 -318 -498 -376 -78 -20 -113 -21 -797 -28 -782 -8 -758 -6 -954 -71 -284 -95 -549 -295 -713 -539 l-30 -45 133 -270 c73 -148 135 -263 138 -255 2 8 12 41 21 74 51 183 184 370 350 494 131 97 289 154 473 172 59 5 344 10 634 10 424 0 540 3 596 15 313 65 578 326 661 650 18 73 40 245 30 245 -2 0 -22 -34 -44 -76z" transform="translate(0,1024) scale(0.1,-0.1)"></path>
              <path d="M2012 6805 c30 -341 233 -629 531 -753 144 -61 163 -62 775 -62 327 0 592 -4 641 -10 283 -36 529 -193 696 -444 64 -98 90 -150 246 -488 235 -511 304 -625 493 -814 272 -271 563 -402 931 -420 230 -12 422 32 645 147 362 187 598 497 687 901 25 117 25 409 0 526 -34 153 -93 298 -172 425 l-37 57 -319 0 c-175 0 -319 -4 -319 -8 0 -5 23 -23 51 -41 225 -147 370 -418 370 -697 1 -401 -259 -742 -647 -845 -95 -25 -286 -31 -379 -10 -208 45 -408 168 -544 334 -86 103 -141 201 -264 467 -281 609 -361 745 -546 930 -173 172 -345 281 -551 349 -195 64 -179 63 -955 71 -771 8 -762 7 -916 67 -91 35 -185 98 -261 173 -59 59 -134 167 -144 207 -13 51 -19 18 -12 -62z" transform="translate(0,1024) scale(0.1,-0.1)"></path>
            </svg>
          </div>
          <span class="font-display tracking-[0.16em] uppercase text-white font-normal text-base">
            Michael Sahlmann
          </span>
        </div>
        <p class="font-display text-sm text-[#D6D6DC]/70 italic">
          "Paraguay puede estar atrasado. Vos no."
        </p>
      </div>

      <!-- Right: Navigation links & Back to Top -->
      <div class="md:col-span-6 flex flex-col md:items-end gap-4">
        <div class="flex flex-wrap gap-5 text-xs font-code text-white/70">
          <a href="#sobre-mi" class="hover:text-[#F26101] transition-colors">Sobre Mí</a>
          <a href="#pilares" class="hover:text-[#F26101] transition-colors">5 Pilares</a>
          <a href="#evidencia" class="hover:text-[#F26101] transition-colors">Evidencia</a>
          <a href="#calculadora" class="hover:text-[#F26101] transition-colors">Calculadora</a>
          <a href="#servicios" class="hover:text-[#F26101] transition-colors">Servicios</a>
          <a href="#contacto" class="hover:text-[#F26101] transition-colors">Contacto</a>
        </div>

        <a
          href="#"
          class="font-code text-[11px] text-[#F26101] hover:text-white transition-colors flex items-center gap-1.5 uppercase tracking-widest mt-2"
        >
          <span>Volver al inicio</span>
          <span>&uarr;</span>
        </a>
      </div>

    </div>

    <!-- Bottom sub-footer -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 font-code text-[10px] text-white/40 tracking-[0.16em] uppercase">
      <div>
        Copyright &copy; {new Date().getFullYear()} Michael Sahlmann. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-4">
        <span>Asunción, Paraguay</span>
        <span>&bull;</span>
        <span class="text-[#F26101] font-semibold">VIDA LEGENDARIA</span>
      </div>
    </div>

  </div>
</footer>
